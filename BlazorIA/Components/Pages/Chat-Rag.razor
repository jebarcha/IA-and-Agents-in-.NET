@page "/chat-rag"
@using BlazorIA.DTOs
@using BlazorIA.Services.Chatbots
@using BlazorIA.Utils
@implements IDisposable
@inject IJSRuntime JS

<div class="chat-wrapper">
    <h3 class="chat-title">Chat over internal documents (RAG)</h3>

    <div class="chat-messages" @ref="messagesContainer">
        @foreach (var message in ChatSession.Conversation)
        {
            <div class="message @GetCSSClass(message.Role)">
                <div class="message-header">@GetLabel(message.Role)</div>
                <div class="message-body">
                    @if (string.IsNullOrEmpty(message.Text))
                    {
                        <div class="typing-indicator">
                            <div class="typing-dots" aria-label="La IA está escribiendo" role="status">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                        </div>
                    } else
                    {
                        @message.Text
                    }
                </div>

                @if (message.MentionedFiles.Any())
                {
                    <div class="mensaje-citas">
                        <div class="citas-titulo">Fuentes</div>

                        <div class="citas-lista">
                            @foreach (var file in message.MentionedFiles.DistinctBy(x => x.FileName))
                            {
                                <a class="cita-card"
                                       href="@($"/documents/{Uri.EscapeDataString(file.FileName)}")">
                                    <div class="cita-card-titulo">@file.FileName</div>
                                    <div class="cita-card-subtitulo">Show document</div>
                                </a>
                            }
                        </div>
                    </div>
                }

            </div>
        }

        @if (ChatSession.PendingApproval is not null)
        {
            <div class="approval-tool">
                <h4>AI wants to execute a sensitive action</h4>
                <p><strong>Tool:</strong> @ChatSession.PendingApproval.ToolName</p>

                @if (ChatSession.PendingApproval.Arguments.Count > 0)
                {
                    <ul>
                        @foreach (var argument in ChatSession.PendingApproval.Arguments)
                        {
                            <li><strong>@argument.Key:</strong> @argument.Value</li>
                        }
                    </ul>
                }

                <div class="approval-actions">
                    <button class="btn btn-success"
                            @onclick="Approve"
                            disabled="@ChatSession.IsProcessing">
                        Approve
                    </button>

                    <button class="btn btn-danger"
                            @onclick="Reject"
                            disabled="@ChatSession.IsProcessing">
                        Reject
                    </button>
                </div>
            </div>
        }

    </div>

    <EditForm Model="model" OnValidSubmit="Send">
        <div class="chat-input">

            <select class="form-select model-selector"
                    @bind="selectedModel"
                    @bind:after="OnModelChange"
                    disabled="@(ChatSession.IsProcessing || ChatSession.PendingApproval is not null)">
                @foreach (var item in availableModels)
                {
                    <option value="@item">@item</option>
                }
            </select>


            <input class="form-control"
                   @bind="model.Text"
                   @bind:event="oninput"
                   placeholder="Type your message..." />

            <button type="submit"
                    class="btn btn-primary"
                    disabled="@DisableSend">
                Send
            </button>

            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="Cancel"
                    disabled="@(!ChatSession.IsProcessing)">
                Cancel
            </button>
        </div>
    </EditForm>
</div>


@code {

    [Inject(Key = "chat-rag")]
    public IChatbot ChatSession { get; set; } = null!;

    private readonly ChatInputModel model = new();
    private ElementReference messagesContainer;
    private bool needsScroll;

    private readonly List<string> availableModels = AIModels.GetAvailableModels().ToList();
    private string selectedModel = AIModels.DefaultModel;

    private void OnModelChange()
    {
        ChatSession.SetModel(selectedModel);
    }

    private bool DisableSend =>
    ChatSession.IsProcessing ||
    ChatSession.PendingApproval is not null ||
    string.IsNullOrWhiteSpace(model.Text);

    protected override void OnInitialized()
    {
        ChatSession.OnChange += HandleChatChange;
    }

    private void HandleChatChange()
    {
        needsScroll = true;
        InvokeAsync(StateHasChanged);
    }

    private async Task Approve()
    {
        needsScroll = true;
        await ChatSession.ResolveApprovalAsync(true);
    }

    private async Task Reject()
    {
        needsScroll = true;
        await ChatSession.ResolveApprovalAsync(false);
    }

    private async Task Send()
    {
        var text = model.Text?.Trim();

        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }

        model.Text = string.Empty;
        needsScroll = true;

        await ChatSession.SendMessageAsync(text);
    }

    private Task Cancel()
    {
        ChatSession.CancelCurrentResponse();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (needsScroll)
        {
            needsScroll = false;
            await JS.InvokeVoidAsync("chatScroll.scrollToBottom", messagesContainer);
        }
    }

    private static string GetLabel(MessageRole role) => role switch
    {
        MessageRole.User => "You",
        MessageRole.AI => "AI",
        MessageRole.System => "System",
        _ => role.ToString()
    };

    private static string GetCSSClass(MessageRole role) => role switch
    {
        MessageRole.User => "user",
        MessageRole.AI => "assistant",
        MessageRole.System => "system",
        _ => role.ToString()
    };

    public void Dispose()
    {
        ChatSession.OnChange -= HandleChatChange;
    }


    private class ChatInputModel
    {
        public string Text { get; set; } = string.Empty;
    }


}
